// --- Sound effects ---------------------------------------------
// These are blank placeholders. Click each tune`` in the Sprig
// editor to open the music tool and draw your own beeps/boops —
// that's most of the fun of making the game truly yours!
const jumpTune  = tune``;
const ringTune  = tune``;
const hurtTune  = tune``;
const winTune   = tune``;

// --- Levels ------------------------------------------------------
// rows 0-6: open air | row 7: mid-air rings (grab mid-jump)
// row 8: player / crates / hazards / flag | row 9: ground (gaps = pits!)
const levels = [
  map`
