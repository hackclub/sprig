<svg width="100%" viewBox="0 0 690 490" role="img" xmlns="http://www.w3.org/2000/svg" style="">
<title style="fill:rgb(0, 0, 0);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto">Cryptveil game thumbnail</title>
<desc style="fill:rgb(0, 0, 0);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:&quot;Anthropic Sans&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto">Pixel art style dungeon thumbnail for the Sprig game Cryptveil</desc>
<defs>
  <pattern id="grid" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
    <rect width="40" height="40" fill="#0a0a14"/>
    <rect width="38" height="38" x="1" y="1" fill="#0e0e1c"/>
  </pattern>
  <pattern id="brick" x="0" y="0" width="40" height="20" patternUnits="userSpaceOnUse">
    <rect width="40" height="20" fill="#1a1428"/>
    <rect width="38" height="8" x="1" y="1" fill="#221a36" rx="1"/>
    <rect width="18" height="8" x="21" y="11" fill="#221a36" rx="1"/>
    <rect width="18" height="8" x="1" y="11" fill="#221a36" rx="1"/>
  </pattern>
</defs>

